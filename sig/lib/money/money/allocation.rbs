class Money
  class Allocation
    # Allocates a specified amount into parts based on their proportions or distributes
    # it evenly when the number of parts is specified numerically.
    #
    # The total of the allocated amounts will always equal the original amount.
    #
    # @param amount [Numeric] Total amount to allocate.
    # @param parts [Numeric | Array[Numeric]] Number of parts or proportional parts.
    # @param decimal_cutoff [bool | Integer] Controls per-split precision.
    # @return [Array[Numeric]] Allocated amounts.
    def self.generate: (Numeric amount, (Numeric | Array[Numeric]) parts, ?(bool | Integer) decimal_cutoff) -> Array[Numeric]

    # @param amount [Integer] Total amount in the currency's smallest unit.
    # @param rules [Array[Hash]] Per-recipient weight, minimum, and maximum.
    # @return [Array[Integer]] Allocated amounts in smallest currency units.
    # @raise [ArgumentError] If the request is impossible or uses invalid units.
    def self.generate_with_constraints: (Integer amount, Array[Hash[Symbol, untyped]] rules) -> Array[Integer]
  end
end
